# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional AI Configuration (Leave blank for ₹0 offline regex fallback parser)
# When ready for real conversational AI, paste your Google Gemini or alternative API key
AI_PROVIDER=fallback
GEMINI_API_KEY=
