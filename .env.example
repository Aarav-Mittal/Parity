# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Configuration
# Options: 'fallback' (Default: ₹0, no key needed) | 'groq' | 'gemini'
AI_PROVIDER=fallback

# Groq Cloud API (Generous free tier, ultra-fast Llama 3.3 70B inference)
# Obtain from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (Alternative)
GEMINI_API_KEY=
